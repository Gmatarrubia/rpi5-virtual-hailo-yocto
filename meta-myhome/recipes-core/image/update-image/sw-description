software =
{
	version = "0.1.0";
	bootloader_transition_marker = false;
	bootloader_state_marker = false;

	@@MACHINE@@ = {
		hardware-compatibility: [ "1.0"];
		stable : {
			copyA : {
				images: (
					{
						filename = "swupdate-podman-hass-image-@@MACHINE@@.rootfs.ext4.gz";
						type = "raw";
						compressed = "zlib";
						device = "/dev/sda4";
						sha256 = "$swupdate_get_sha256(swupdate-podman-hass-image-@@MACHINE@@.rootfs.ext4.gz)";
					},
					{
						filename = "swupdate-podman-hass-boot.vfat";
						device = "/dev/sda2";
						sha256 = "$swupdate_get_sha256(swupdate-podman-hass-boot.vfat)";
						type = "raw";
					}
				);
				scripts: (
					{
						filename = "ab-update-hook.sh";
						type = "shellscript";
						data = "A";
					}
				)
			};
			copyB : {
				images: (
					{
						filename = "swupdate-podman-hass-image-@@MACHINE@@.rootfs.ext4.gz";
						type = "raw";
						compressed = "zlib";
						device = "/dev/sda5";
						sha256 = "$swupdate_get_sha256(swupdate-podman-hass-image-@@MACHINE@@.rootfs.ext4.gz)";
					},
					{
						filename = "swupdate-podman-hass-boot.vfat";
						device = "/dev/sda3";
						sha256 = "$swupdate_get_sha256(swupdate-podman-hass-boot.vfat)";
						type = "raw";
					}
				);
				scripts: (
					{
						filename = "ab-update-hook.sh";
						type = "shellscript";
						data = "B";
					}
				)
			};
		};
	}
}
