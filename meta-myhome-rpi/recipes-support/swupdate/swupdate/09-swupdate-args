rootfs=`swupdate -g`

if [ $rootfs == '/dev/sda4' ];then
	selection="-e stable,copyB"
else
	selection="-e stable,copyA"
fi

if [ -e /media/etc/swupdate.cfg ];then
	CFGFILE="/media/etc/swupdate.cfg"
else
	CFGFILE="/etc/swupdate.cfg"
fi

SWUPDATE_WEBSERVER_ARGS="--document-root /www --port 8080"
SWUPDATE_ARGS="-H @MACHINE@:1.0 ${selection} -p '/usr/bin/tryboot.sh' -f ${CFGFILE}"
